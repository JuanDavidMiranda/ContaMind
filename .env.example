# Entorno de la aplicación. En development se usa un usuario local sin autenticación real.
APP_ENV=development
APP_NAME=ContaMind AI

# PostgreSQL local del docker-compose. No uses estas credenciales fuera de tu máquina.
DATABASE_URL=postgresql+psycopg://contamind:contamind@localhost:5432/contamind

# Directorio privado, fuera de la carpeta pública del frontend.
STORAGE_DIR=storage

# Límites del procesamiento síncrono del MVP.
MAX_UPLOAD_BYTES=10485760
MAX_ROWS_PER_FILE=10000

# Orígenes permitidos para el navegador.
CORS_ORIGINS=http://localhost:3000

# Usuario local que se crea al arrancar en development.
DEV_USER_EMAIL=dev@contamind.local
DEV_USER_NAME=Usuario local de desarrollo

# El frontend usa esta URL solo si no reescribe /api hacia el backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
